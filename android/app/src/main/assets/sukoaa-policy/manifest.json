{
  "manifest_version": 3,
  "name": "Sukoaa page policy",
  "version": "1.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-policy@sukoaa.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "youtube-start.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "media-start.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
