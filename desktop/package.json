{
  "name": "aegis-browser",
  "version": "0.9.3",
  "description": "Sukoaa browser beta candidate; public release gated",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test ../tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:linux": "node build-linux.cjs",
    "dist:windows": "electron-builder --win nsis --x64",
    "dist:windows:internal": "node build-windows-internal.cjs",
    "prestart": "node ../tools/sync-page-scripts.cjs"
  },
  "keywords": [],
  "author": "Subo",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "dependencies": {
    "@ghostery/adblocker": "2.20.1",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "45.2.3",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "com.subo.aegis",
    "productName": "Sukoaa Browser",
    "directories": {
      "output": "../build/desktop"
    },
    "files": [
      "*.cjs",
      "*.html",
      "*.css",
      "*.js",
      "package.json",
      "assets/**",
      "!after-pack.cjs",
      "!build-linux.cjs",
      "!build-windows-internal.cjs",
      "!clean-windows-stage.cjs",
      "!before-pack.cjs",
      "!release-fuses.cjs",
      {
        "from": "../shared",
        "to": "shared",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/aegis.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "assets/aegis.png",
      "artifactName": "SukoaaBrowser-${version}-linux-${arch}.${ext}",
      "synopsis": "Private browsing with built-in request filtering",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSCameraUsageDescription": "Use the camera only for websites you approve in Sukoaa.",
        "NSMicrophoneUsageDescription": "Use the microphone only for websites you approve in Sukoaa.",
        "NSLocationWhenInUseUsageDescription": "Share location only with websites you approve in Sukoaa."
      }
    },
    "afterPack": "./after-pack.cjs",
    "appImage": {
      "executableArgs": []
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Sukoaa Browser",
      "uninstallDisplayName": "Sukoaa Browser",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "license": "../LICENSE",
      "artifactName": "SukoaaBrowser-${version}-Windows-x64-Setup.${ext}"
    },
    "artifactBuildStarted": "./clean-windows-stage.cjs",
    "beforePack": "./before-pack.cjs"
  },
  "desktopName": "aegis-browser"
}
